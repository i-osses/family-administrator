# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend Email Configuration (for family invitations)
RESEND_API_KEY=re_your_resend_api_key
# Optional: custom verified sender address (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=Family Administrator <onboarding@resend.dev>

# Public Application URL (used in OAuth callbacks and invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
